  "fixes": [
    {
      "commit": "40ff811",
      "issue": "Force and reaction-moment magnitudes were mixed in reaction envelopes",
      "resolution": "Separate kN force and kN.m moment envelopes and controls; preserve unavailable moments",
      "regression": "3 m cantilever with 2 kN tip load: 2 kN reaction, 6 kN.m reaction moment; independent multi-case controls"
    },
    {
      "commit": "ca5d556",
      "issue": "Stable-ID material/section diagnostics could survive valid explicit corrections",
      "resolution": "Resolve index, dotted and quoted/bracket stable IDs consistently, without clearing conflicts or other objects"
    },
    {
      "commit": "357977c",
      "issue": "Frontend workflow mocks supplied invalid capability catalogs",
      "resolution": "Repair stale test fixtures; retain the production readiness gate and original assertions"
    },
    {
      "commit": "6b166bf",
      "issue": "Explicit default comparison option rejected a valid single-result query",
      "resolution": "absolute-max is inert without comparison keys; preserve sign, result selection and quantity ID; max/min still require comparison keys"
    },
    {
      "commit": "0cb1048",
      "issue": "Extractor could invent executable design fields or non-string basis values and poison the persisted draft",
      "resolution": "Pass authoritative V2 design definitions; reject invalid generated design before state commit; repeated bad extractions consume the existing recovery budget; force-only extraction does not require the protocol service"
    },
    {
      "commit": "9a7ae5f",
      "issue": "Summary-only code-check feedback left the final chat without the formulas and values needed for a correct explanation",
      "resolution": "Return bounded per-item computed evidence with run, member, result, formula, demand, capacity, unit and utilization; distinguish different checks explicitly"
    }
  ],
